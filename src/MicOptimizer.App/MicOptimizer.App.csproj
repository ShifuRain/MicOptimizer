<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MicOptimizer.Core\MicOptimizer.Core.csproj" />
    <ProjectReference Include="..\MicOptimizer.Audio\MicOptimizer.Audio.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>

    <AssemblyName>MicOptimizer</AssemblyName>
    <RootNamespace>MicOptimizer.App</RootNamespace>
    <Product>Mic Optimizer</Product>
    <Version>1.1.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF and Windows Forms both define Application, Button, MessageBox... keep only WPF's names implicit. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
