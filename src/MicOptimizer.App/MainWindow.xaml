<Window x:Class="MicOptimizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MicOptimizer.App.ViewModels"
        xmlns:ctl="clr-namespace:MicOptimizer.App.Controls"
        Title="Mic Optimizer" Icon="Assets/app.ico" Width="1220" Height="920" MinWidth="820" MinHeight="620"
        Background="{StaticResource PanelBrush}" FontFamily="{StaticResource UiFont}" FontSize="13">

    <Window.Resources>
        <!-- Profiles and audio devices both show their Name in the drop-downs -->
        <DataTemplate x:Key="NameTemplate">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DataTemplate>

        <!-- A switch with a label to its right, used for options inside a section -->
        <DataTemplate x:Key="ToggleRow" DataType="{x:Type vm:ToggleVm}">
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <ToggleButton DockPanel.Dock="Left" Style="{StaticResource Pill}" IsChecked="{Binding IsOn}"
                              AutomationProperties.Name="{Binding Label}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            </DockPanel>
        </DataTemplate>

        <!-- A labelled fader with its current value -->
        <DataTemplate x:Key="ParamRow" DataType="{x:Type vm:ParamVm}">
            <StackPanel Margin="0,0,0,8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Readout}" Text="{Binding Display}"
                               Margin="8,0,0,0" VerticalAlignment="Top"/>
                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" Foreground="{StaticResource InkBrush}"/>
                </DockPanel>
                <Slider Minimum="{Binding Min}" Maximum="{Binding Max}" SmallChange="{Binding Step}"
                        LargeChange="{Binding Step}" Value="{Binding Value, Mode=TwoWay}"
                        AutomationProperties.Name="{Binding Label}"/>
            </StackPanel>
        </DataTemplate>

        <!-- One processing stage -->
        <DataTemplate DataType="{x:Type vm:SectionVm}">
            <Border Width="246" Margin="0,0,12,12" Padding="14,12,14,10" CornerRadius="6"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Right" Style="{StaticResource Pill}" IsChecked="{Binding PowerOn}"
                                      Visibility="{Binding HasPower, Converter={StaticResource BoolToVis}}"
                                      AutomationProperties.Name="{Binding Title}"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Eyebrow}"
                                   Foreground="{StaticResource InkBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Caption}" Margin="0,4,0,12" MinHeight="30"/>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PowerOn}" Value="False">
                                        <Setter Property="Opacity" Value="0.45"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ItemsControl ItemsSource="{Binding Toggles}" ItemTemplate="{StaticResource ToggleRow}" IsTabStop="False"/>
                        <ItemsControl ItemsSource="{Binding Params}" ItemTemplate="{StaticResource ParamRow}" IsTabStop="False"/>
                    </StackPanel>

                    <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" Padding="0,7,0,0">
                        <TextBlock Style="{StaticResource Readout}" Foreground="{StaticResource InkMutedBrush}"
                                   Text="{Binding Live}" MinHeight="16" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22,18,10,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title, bypass, start/stop -->
        <Grid Grid.Row="0" Margin="0,0,12,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MIC OPTIMIZER" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Steady, clean microphone sound for calls, streams and recordings" Style="{StaticResource Caption}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Pill}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                              AutomationProperties.Name="Start with Windows"
                              ToolTip="Open hidden in the tray when you sign in, and start processing"/>
                <TextBlock Text="Start with Windows" Margin="8,0,24,0" VerticalAlignment="Center"/>
                <ToggleButton Style="{StaticResource Pill}" IsChecked="{Binding Bypass}" AutomationProperties.Name="Bypass"
                              ToolTip="Send the microphone through unprocessed, to compare"/>
                <TextBlock Text="Bypass" Margin="8,0,24,0" VerticalAlignment="Center"/>
                <Button Style="{StaticResource RunButton}" Command="{Binding ToggleRunCommand}"/>
            </StackPanel>
        </Grid>

        <!-- Profile -->
        <Border Grid.Row="1" Margin="0,0,12,10" Padding="14,10" CornerRadius="6"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="PROFILE" Style="{StaticResource Eyebrow}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" ItemTemplate="{StaticResource NameTemplate}"
                              MinWidth="210" AutomationProperties.Name="Profile"/>
                    <TextBlock Text="Edited" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="12,0,0,0"
                               VerticalAlignment="Center" Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0"/>
                        <Button Content="Save as…" Command="{Binding SaveAsCommand}" Margin="0,0,6,0"/>
                        <Button Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,6,0"/>
                        <Button Content="Delete" Command="{Binding DeleteCommand}"/>
                    </StackPanel>
                    <Border/>
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding ProfileDescription}" Style="{StaticResource Caption}" Margin="0,8,0,0"/>
            </Grid>
        </Border>

        <!-- Devices -->
        <Border Grid.Row="2" Margin="0,0,12,10" Padding="14,10" CornerRadius="6"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="MICROPHONE" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Inputs}" SelectedItem="{Binding SelectedInput}" ItemTemplate="{StaticResource NameTemplate}"
                              AutomationProperties.Name="Microphone"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="WHICH INPUT" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding ChannelChoices}" SelectedIndex="{Binding InputChannel}" MinWidth="130"
                                  AutomationProperties.Name="Input channel"/>
                        <Button Content="Find my mic" Command="{Binding FindMicCommand}" Margin="8,0,0,0" Padding="10,3"
                                ToolTip="Speak for 3 seconds and pick the input that hears you"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="SEND TO" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Rescan" Command="{Binding RefreshDevicesCommand}" Margin="8,0,0,0" Padding="10,3"/>
                        <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" ItemTemplate="{StaticResource NameTemplate}"
                                  AutomationProperties.Name="Send to"/>
                    </DockPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Caption}" Margin="0,8,0,0"
                           Text="In Discord, OBS or your recorder, choose “CABLE Output” as the microphone to hear the processed sound."/>

                <!-- Only shown when the VB-Cable virtual device isn't installed -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Padding="12,8" CornerRadius="4"
                        Background="{StaticResource AccentSoftBrush}" Visibility="{Binding CableMissing, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Get VB-Cable" Command="{Binding OpenCableDownloadCommand}" Margin="12,0,0,0" Padding="10,3"/>
                        <TextBlock VerticalAlignment="Center"
                                   Text="VB-Cable isn't installed. It is the free virtual microphone other apps listen to. Install it, restart Windows if asked, then press Rescan."/>
                    </DockPanel>
                </Border>

                <!-- Delay: mode, where the milliseconds go, and the part that belongs to VB-Cable -->
                <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="LATENCY" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding LatencyChoices}" SelectedIndex="{Binding LatencyModeIndex}" MinWidth="330"
                                  AutomationProperties.Name="Latency mode"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource Caption}"
                               Foreground="{StaticResource InkBrush}" Margin="0,0,16,6" Text="{Binding LatencySummary}"/>
                    <Button Grid.Column="2" VerticalAlignment="Bottom" Content="Reduce VB-Cable delay…" Padding="10,3"
                            Command="{Binding OpenCablePanelCommand}"
                            Visibility="{Binding CablePanelAvailable, Converter={StaticResource BoolToVis}}"
                            ToolTip="VB-Cable adds its own delay (about 60 ms at its default setting). Open its control panel and lower Max Latency."/>
                </Grid>
            </Grid>
        </Border>

        <!-- Live trace and meters -->
        <Border Grid.Row="3" Margin="0,0,12,12" CornerRadius="6" ClipToBounds="True"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid Height="170">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ctl:TraceView x:Name="Trace" Grid.Column="0"/>
                <Border Grid.Column="1" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="IN" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Grid.Column="1" Text="OUT" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <ctl:Meter Grid.Row="1" Width="18" Value="{Binding InputDb}" Margin="8,0"/>
                        <ctl:Meter Grid.Row="1" Grid.Column="1" Width="18" Value="{Binding OutputDb}" Margin="8,0"/>
                        <TextBlock Grid.Row="2" Style="{StaticResource Readout}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Text="{Binding InputDb, StringFormat='{}{0:0}'}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Readout}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                   Text="{Binding OutputDb, StringFormat='{}{0:0}'}"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Processing stages -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
            <ItemsControl ItemsSource="{Binding Sections}" IsTabStop="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status -->
        <Border Grid.Row="5" Margin="0,2,12,0" Padding="0,8,0,0" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Foreground="{StaticResource InkBrush}"/>
        </Border>
    </Grid>
</Window>
